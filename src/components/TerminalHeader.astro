---
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const homeHref = Astro.site
  ? new URL(base, Astro.site).pathname
  : base;
---

<header class="terminal__header">
  <a href={homeHref} class="terminal__title">
    <span class="text-scramble" data-scramble-speed="70">Ikhsan's Notes</span>
  </a>
  <div></div>
  <div class="terminal__tools">O</div>
</header>
